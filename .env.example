# Copy to .env and fill in values. Never commit .env.

# OpenRouter (https://openrouter.ai/keys) — required for /api/chat
OPENROUTER_API_KEY=
# Models per task (team decision, docs/stack.md#ai-models). Ids from https://openrouter.ai/models
# Psst chat over the dataset (code default: openrouter/auto)
OPENROUTER_MODEL=openai/gpt-6-luna
# Voice to text
OPENROUTER_TRANSCRIBE_MODEL=google/gemini-3.5-flash-lite
# Receipt photos: the vision model reads the photo; the OCR engine is not used yet
OPENROUTER_OCR_ENGINE=mistral-ocr
OPENROUTER_VISION_MODEL=google/gemini-3.5-flash-lite
# Demo date of the story (code default 2025-11-21): the chat sees no data after this day
DEMO_TODAY=2025-11-21
# Pitch only: answer with the prepared LOLA scan when the vision model fails
# DEMO_SCAN_FALLBACK=1

# Discord incoming webhook for the team questions channel — used by scripts/ask-team.sh
# (setup: docs/gitops.md#team-questions-channel). Optional.
DISCORD_QUESTIONS_WEBHOOK_URL=
